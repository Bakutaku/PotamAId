{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "新機能" },
    { "type": "fix", "section": "バグ修正" },
    { "type": "perf", "section": "パフォーマンス改善" },
    { "type": "revert", "section": "取り消し" },
    { "type": "docs", "section": "ドキュメント", "hidden": true },
    { "type": "style", "section": "スタイル", "hidden": true },
    { "type": "refactor", "section": "リファクタリング", "hidden": true },
    { "type": "test", "section": "テスト", "hidden": true },
    { "type": "build", "section": "ビルド", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "その他", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "potamaid",
      "extra-files": [
        {
          "type": "generic",
          "path": "gradle.properties"
        }
      ]
    }
  }
}
